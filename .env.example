# Local server. Keep real secrets in the deployment secret manager, never in this file.
# A public production process must also pass `pnpm run preflight:production`; see docs/PRODUCTION_DEPLOYMENT.md.
HOST=127.0.0.1
PORT=4173
TRUST_PROXY=false
# Leave blank for direct/CIDR mode. Render deployments use `render`; the app then verifies Render's runtime identity.
TRUST_PROXY_PROVIDER=
# Required for generic TRUST_PROXY=true mode; blank when TRUST_PROXY_PROVIDER=render.
# A generic proxy must remove incoming forwarding headers and write exactly one X-Forwarded-For IP.
TRUSTED_PROXY_CIDRS=
APP_ORIGIN=http://127.0.0.1:4173
# Store private pilot records outside OneDrive, Dropbox, Google Drive and iCloud. Use an absolute non-synchronised path.
DATA_DIR=
# Keep false for a single-user local pilot. Set true wherever localhost access must also present ADMIN_KEY.
ADMIN_REQUIRE_KEY=false
ADMIN_KEY=
# The legacy concierge pilot writes local private files. Keep true only with reviewed durable private storage.
# A free Render preview must set this false because its filesystem is temporary.
PILOT_INTAKE_ENABLED=true

# PostgreSQL marketplace database (required before authenticated production use).
MARKETPLACE_ENABLED=false
# Public launch attestations. Keep false during restricted staging. Set true only after the
# named evidence is approved and stored outside source control; these switches store no evidence.
PUBLIC_MARKETPLACE_APPROVED=false
LEGAL_BUSINESS_READY=false
INSURANCE_READY=false
CLEANER_SUPPLY_READY=false
PRICING_POLICY_APPROVED=false
CUSTOMER_SUPPORT_READY=false
CUSTOMER_TERMS_READY=false
# Absolute path/file URL to a deployment-owned monitoring/optional-ETA module exporting createMarketplaceDeploymentAdapters({ env }).
MARKETPLACE_ADAPTER_MODULE=
# Normal requests may use a managed transaction-pooled URL once load testing proves the pool size.
DATABASE_URL=postgresql://tideway_app:replace-me@127.0.0.1:5432/tideway
# Live booking updates require a direct session connection to the same database because LISTEN/NOTIFY
# is not compatible with transaction-mode pooling. The app reserves exactly one connection per instance.
REALTIME_DATABASE_URL=postgresql://tideway_app:replace-me@127.0.0.1:5432/tideway
# Separate restricted scheduler credential; never use this connection for web requests.
WORKER_DATABASE_URL=postgresql://tideway_worker:replace-me@127.0.0.1:5432/tideway
WORKER_DATABASE_POOL_MAX=5
# The maintenance scheduler is a separate process. Keep every capability false until its staging gate passes.
MARKETPLACE_WORKER_ENABLED=false
WORKER_EMAIL_ENABLED=false
WORKER_MEDIA_ENABLED=false
WORKER_AUTOMATIC_DISPATCH_ENABLED=false
DATABASE_POOL_MAX=10
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_TOKEN_SECRET=replace-with-a-different-32-character-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-third-distinct-32-character-random-secret

# Email/password verification, password reset and privacy-minimal booking notifications.
# Use a credentialed smtp/smtps hostname. Paths, query options and fragments are rejected.
EMAIL_DELIVERY_PROVIDER=smtp
SMTP_URL=smtps://user:password@smtp.example.com:465
# Render free services must use HTTPS delivery instead: set EMAIL_DELIVERY_PROVIDER=resend,
# remove SMTP_URL, and store a real RESEND_API_KEY only in the deployment secret manager.
# RESEND_API_KEY=re_replace_in_secret_manager
EMAIL_FROM=Homle <no-reply@homle.co.uk>
# Zero-cost Render staging may use privacy-minimal platform logs after access review.
# MARKETPLACE_ADAPTER_MODULE=homle:render-log-monitoring
# RENDER_LOG_MONITORING_ACKNOWLEDGED=false

# OAuth providers. Configure a complete pair/set or leave the provider entirely blank.
# Google Web redirect URI must exactly equal:
#   https://homle.co.uk/api/marketplace/auth/google/callback
# Apple Services ID return URL must exactly equal:
#   https://homle.co.uk/api/marketplace/auth/apple/callback
# APPLE_PRIVATE_KEY accepts PKCS#8 PEM, with literal \n line breaks when the secret manager stores one line.
# Select only the providers being activated, then run `pnpm run preflight:authentication` before staging.
TIDEWAY_EXPECT_SOCIAL_PROVIDERS=google
# Exact eight-character sourceCommit from the verified package manifest. Authentication activation and the worker refuse a different or unidentified runtime.
TIDEWAY_EXPECT_RELEASE=
# Facebook remains unavailable until mailbox verification plus the signed Meta data-deletion callback pass real PostgreSQL, SMTP, HTTPS and Meta app staging.
# Meta data-deletion callback URL:
#   https://homle.co.uk/api/marketplace/auth/facebook/data-deletion
# Public confirmation/status page:
#   https://homle.co.uk/facebook-data-deletion
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Pin the exact Graph API version shown as supported by the Homle Meta app (for example vNN.N); do not guess or silently float it.
FACEBOOK_GRAPH_API_VERSION=

# Private image storage. Use restricted server credentials, never browser credentials.
OBJECT_STORAGE_ENDPOINT=https://objects.example.com
OBJECT_STORAGE_BUCKET=tideway-private
OBJECT_STORAGE_REGION=eu-west-2
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Use true only when the selected S3-compatible provider requires path-style bucket URLs.
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Google Maps Platform uses two separately restricted keys. The browser key is
# visible by design and must be restricted to Homle's HTTPS origins and only the
# Maps JavaScript API. The server key remains secret and must be restricted to
# Places API (New), Geocoding API and Routes API. Never reuse Google sign-in keys.
MAP_PROVIDER=none
GOOGLE_MAPS_BROWSER_API_KEY=
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_MAP_ID=

# Server-side postcode-to-coordinate resolution for distance matching. A failed
# lookup never blocks a save; Homle keeps its outward-postcode fallback.
GEOCODING_PROVIDER=none

# Authenticated UK address autocomplete for Cleaner onboarding. A selected
# result remains editable before the reviewed address is saved.
ADDRESS_LOOKUP_PROVIDER=none

# Live road ETA. google-maps uses Routes and falls back to the existing
# server-only straight-line estimate when Google is unavailable.
ETA_PROVIDER=straight-line

# Private booking economics. Configure every value together after founder approval; these never belong in browser code.
BOOKING_TARGET_MARGIN_BPS=
BOOKING_MINIMUM_CONTRIBUTION_PENCE=
BOOKING_LABOUR_ON_COST_BPS=
BOOKING_PAYMENT_FEE_BPS=
BOOKING_PAYMENT_FEE_FIXED_PENCE=
BOOKING_RISK_CONTINGENCY_BPS=
BOOKING_TRAVEL_COST_PENCE=
BOOKING_TRAVEL_COST_PER_KM_PENCE=
BOOKING_TRAVEL_DISTANCE_MULTIPLIER_BPS=
BOOKING_SUPPLIES_COST_PENCE=
BOOKING_OTHER_COST_PENCE=
BOOKING_INVITATION_TTL_MINUTES=

# Stripe Connect preparation. Keep false until the founder-approved test platform, webhook endpoint and staging database all pass.
# This adapter rejects live keys. Store both secrets in the deployment secret manager, never in this file or browser code.
PAYMENTS_ENABLED=false
PUBLIC_PAYMENTS_APPROVED=false
PAYMENT_ACCOUNT_VERIFIED=false
REFUND_PROCESS_READY=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Vision and language provider. Used by the room scan (photo reading) and by the spoken
# brief summary. Both features fail closed with a clean 503 when it is absent, so the
# deployment stays healthy without it — but neither feature works. Store the real key in
# the deployment secret manager, never in this file.
ANTHROPIC_API_KEY=

# The room scan makes up to five reads per room: four while the customer walks,
# which only need each object named, and one when they confirm the room, which
# produces the condition grade and the checklist the job is priced and timed from.
# Leave both unset to run everything on the cheap tier, exactly as before.
# Setting only the second buys better judgement on the one read that sets the
# price, at roughly a fifth of the cost of raising both.
# ROOM_VISION_MODEL=claude-haiku-4-5
# ROOM_VISION_CONFIRMATION_MODEL=claude-opus-4-8
